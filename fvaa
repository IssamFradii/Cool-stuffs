# 9. Self-tests
# =============================================================================
def selftest(verbose: bool = True) -> None:
    def ok(cond, msg):
        if not cond:
            raise AssertionError(msg)

    # labels
    for lab, y in [("3M", .25), ("18M", 1.5), ("1Y6M", 1.5), ("10Y", 10.0)]:
        ok(abs(to_years(lab) - y) < 1e-12, f"to_years {lab}")
    ok(FvaPoint.parse("6mx6mx10y").name == "6Mx6Mx10Y", "point parse")
    idx = pd.bdate_range("2020-01-01", periods=300)
    # flat surface -> forward = spot
    flat = pd.DataFrame({f"{e}x10Y": 80.0 for e in ["3M", "6M", "1Y", "2Y", "5Y"]}, index=idx)
    sf = VolSurface(flat)
    ok(np.allclose(sf.cal_forward(1, 1, "10Y"), 80.0), "flat surface forward != spot")
    # total-variance additivity
    rng = np.random.default_rng(0)
    vols = pd.DataFrame({f"{e}x10Y": 70 + 10 * rng.random(300) for e in ["3M", "6M", "1Y", "2Y", "5Y"]}, index=idx)
    sv = VolSurface(vols)
    f = sv.cal_forward(1, 1, "10Y")
    rec = np.sqrt((sv.spot(1, "10Y") ** 2 * 1 + f ** 2 * 1) / 2)
    m = f.notna()
    ok(np.allclose(rec[m], sv.spot(2, "10Y")[m]), "additivity")
    # scalar interpolation used by the event engine matches the vectorized one
    tsv = np.asarray(sv.terms["10Y"].columns, float)
    for T in (0.1, 0.25, 0.8, 1.7, 7.0):
        ok(abs(_tv(tsv, sv.terms["10Y"].to_numpy()[17], T) - sv.total_var(T, "10Y").iloc[17]) < 1e-9, "_tv")
    # levels regression recovers OU mean reversion exactly (sigma_F - theta = e^{-k s}(sigma_S - theta))
    th, kap, s = 75.0, 1.2, 0.5
    S = pd.Series(75 + np.cumsum(rng.normal(0, 1, 2000)) * 0.3, index=pd.bdate_range("2015-01-01", periods=2000))
    F = th + math.exp(-kap * s) * (S - th) + rng.normal(0, 1e-4, 2000)
    r = rolling_ols(F, S, 252).iloc[-1]
    k_hat, th_hat, _ = implied_mean_reversion(pd.Series([r.alpha]), pd.Series([r.beta]), s)
    ok(abs(k_hat.iloc[0] - kap) < 1e-3 and abs(th_hat.iloc[0] - th) < 0.5, "implied kappa/theta")
    # realized persistence of an AR(1): slope of x(t+h) on x(t) ~ phi^h
    ph, nn, hh = 0.98, 60000, 21
    x = np.zeros(nn)
    e = rng.standard_normal(nn)
    for i in range(1, nn):
        x[i] = ph * x[i - 1] + e[i]
    xs = pd.Series(x)
    b = ols_nw(xs.shift(-hh), xs, lags=hh)["coef"][1]
    ok(abs(b - ph ** hh) < 0.03, f"AR persistence {b:.3f} vs {ph ** hh:.3f}")
    # OLS coefficients match lstsq
    X = rng.normal(size=(500, 2))
    yv = 1 + X @ np.array([0.5, -2]) + rng.normal(size=500)
    rr = ols_nw(pd.Series(yv), [pd.Series(X[:, 0]), pd.Series(X[:, 1])], lags=5)
    ref = np.linalg.lstsq(np.column_stack([np.ones(500), X]), yv, rcond=None)[0]
    ok(np.allclose(rr["coef"], ref), "OLS coefficients")
    # P&L convention: flat surface -> zero FVA P&L
    cfg = Config(win_beta=60, win_z=60, theta_window=60)
    pt = FvaPoint.parse("3Mx3Mx10Y")
    g, _ = build_signals(sf, pt, cfg)
    legs = leg_pnls(sf, pt, cfg, g)
    ok(np.allclose(legs["fix"].dropna(), 0.0) and np.allclose(legs["mtm"].dropna(), 0.0), "flat-surface P&L")
    # gamma/theta: flat implied 77bp, realized 70bp -> long 6M straddle held 21d loses
    # (70^2 - 77^2) * (21/252) / (2 * 77 * 0.5) = -1.114 bp per unit vega
    n2 = 20 * TD
    idx2 = pd.bdate_range("2000-01-03", periods=n2)
    gdf = pd.DataFrame({f"{e}x10Y": 77.0 for e in ["3M", "6M", "1Y", "2Y"]}, index=idx2)
    gdf["SWAP_10Y"] = 3 + np.cumsum(rng.normal(0, 70 / math.sqrt(TD), n2)) / 100
    gs = VolSurface(gdf)
    p6 = FvaPoint.parse("6Mx6Mx10Y")
    gg, _ = build_signals(gs, p6, Config())
    lg = leg_pnls(gs, p6, Config(), gg)
    theo = (70 ** 2 - 77 ** 2) * (21 / TD) / (2 * 77 * 0.5)
    ok(abs(lg["spot_gamma"].mean() - theo) < 0.12, f"gamma/theta {lg['spot_gamma'].mean():.3f} vs {theo:.3f}")
    # Stein estimator on long synthetic samples: over-reaction built in at 3M (kYQ < kY).
    # No-premium, no-noise control: implied and realized persistence must agree (iterated expectations).
    c0 = Config(cost_fva_bp=0.0, cost_spot_bp=0.0)
    ctrl, _ = simulate(n_years=80, seed=3, kYQ=6.0, pi_st=0.0, pi_lt=0.0, noise_sd=0.0)
    dc = run_point(VolSurface(ctrl), FvaPoint.parse("3Mx3Mx10Y"), c0, tranche=[], events=[]).diag
    ok(abs(dc["stein_gap"]) < 0.04, f"control: stein gap should be ~0, got {dc['stein_gap']:.3f}")
    ok(abs(dc["EH_b"] - 1) < 0.15, f"control: EH slope should be ~1, got {dc['EH_b']:.2f}")
    lng, _ = simulate(n_years=80, seed=3, noise_sd=0.0)
    dl = run_point(VolSurface(lng), FvaPoint.parse("3Mx3Mx10Y"), c0, tranche=[], events=[]).diag
    ok(dl["stein_gap"] > 0.03 and dl["EH_b"] > 1, "over-reaction (kYQ < kY) not detected")
    # recovery + engine consistency on the standard 16y synthetic surface
    df, truth = simulate()
    surf = VolSurface(df)
    r33 = run_point(surf, FvaPoint.parse("3Mx3Mx10Y"), c0)
    r11 = run_point(surf, FvaPoint.parse("1Yx1Yx10Y"), c0, tranche=[], events=["ev_long_fva_to_fixing"])
    st = r33.stats.set_index("strategy")
    ok(r33.diag["mean_carry_bp"] > 0 and r11.diag["mean_carry_bp"] > 0, "premium structure -> positive carry")
    ok(st.at["resid_mr", "gross_bp_trade"] > 0, "residual mean reversion should pay gross of costs")
    ok(st.at["long_fva_fix", "gross_bp_trade"] > 0, "long FVA should earn the premium term structure")
    tr = r11.events["ev_long_fva_to_fixing"][0]
    fx = r11.legs["fix"].reindex(tr["entry"]).to_numpy()
    ok(np.allclose(tr["gross_bp"].to_numpy()[:-1], fx[:-1], atol=1e-8), "event engine != hold-to-fixing leg")
    # FVA-only carry accounting: on a vol surface that never changes, the h-day MTM of a long FVA is
    # exactly its roll along the forward-vol curve, i.e. the carry signal
    stat = pd.DataFrame({"3Mx10Y": 92.0, "6Mx10Y": 88.0, "1Yx10Y": 84.0, "2Yx10Y": 80.0, "3Yx10Y": 78.0,
                         "5Yx10Y": 76.0}, index=pd.bdate_range("2018-01-01", periods=400))
    ss = VolSurface(stat)
    p11 = FvaPoint.parse("1Yx1Yx10Y")
    gst, _ = build_signals(ss, p11, Config())
    lst = leg_pnls(ss, p11, Config(), gst)
    mm = lst["mtm"].notna()
    ok(mm.any() and np.allclose(lst["mtm"][mm], gst["roll_h"][mm]), "static surface: FVA MTM != roll")
    ok(bool((gst["roll_h"] > 0).all()), "a vol curve falling with expiry should give long FVA positive roll")
    # FVA vs FVA engine: identical legs with beta 1 must make exactly zero gross P&L
    pa = FvaPoint.parse("6Mx1Yx10Y")
    gp, ga, gb = build_pair_signals(surf, pa, pa, c0)
    gp = gp.assign(beta=1.0, resid_z=0.0, ctr_z=0.0)
    one = pd.Series(1.0, index=gp.index)
    trp, _ = pair_event_backtest(surf, pa, pa, c0, gp, ga, gb, one, one, 63)
    ok(len(trp) > 10 and float(np.abs(trp["gross_bp"]).max()) < 1e-9, "identical-leg pair should make zero P&L")
    # cross-sectional carry book is vega-neutral: weights sum to 0, one unit long and one unit short
    pts = [FvaPoint.parse(x) for x in ("3Mx3Mx10Y", "6Mx6Mx10Y", "6Mx1Yx10Y", "1Yx1Yx10Y")]
    rs = {pt.name: run_point(surf, pt, c0, tranche=[], events=[]) for pt in pts}
    _, wx, _ = xs_carry(rs, c0)
    wv = wx.dropna(how="all")
    ok(len(wv) > 100 and np.allclose(wv.sum(axis=1), 0) and np.allclose(wv.abs().sum(axis=1), 2), "xs weights")
    if verbose:
        print("selftest: all checks passed")
        print(f"  synthetic truth: {truth}")
        print(f"  gamma/theta check: {lg['spot_gamma'].mean():.3f} vs theory {theo:.3f} bp")
        print(f"  80y control (no premium, kQ=kP)  3Mx3M: stein gap {dc['stein_gap']:+.3f}, EH b {dc['EH_b']:.2f}")
        print(f"  80y over-reaction (kYQ<kY)        3Mx3M: stein gap {dl['stein_gap']:+.3f}, EH b {dl['EH_b']:.2f}")
        for nm, rp in (("3Mx3Mx10Y", r33), ("1Yx1Yx10Y", r11)):
            d = rp.diag
            print(f"  16y {nm}: carry {d['mean_carry_bp']:.2f}bp | beta lvl {d['beta_levels']:.3f} vs realized "
                  f"{d['beta_realized_h']:.3f} (se {d['se_beta_realized']:.3f}) | EH b {d['EH_b']:.2f} "
                  f"(t vs 1: {d['EH_t(b=1)']:.1f}) | ~{d['n_independent']:.0f} independent obs")
        print(f"  static vol curve: 1Yx1Yx10Y FVA MTM equals its roll exactly "
              f"({gst['roll_h'].iloc[0]:+.3f}bp per {Config().hold_days} days)")
        print("  identical-leg FVA pair: zero P&L; cross-sectional carry book: vega-neutral")


