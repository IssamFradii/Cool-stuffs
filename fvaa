def main(argv=None) -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--demo", action="store_true")
    ap.add_argument("--csv")
    ap.add_argument("--points", default="3Mx3Mx10Y,6Mx6Mx10Y,1Yx1Yx10Y")
    ap.add_argument("--split", default=None, help="in/out-of-sample split date, e.g. 2021-01-01")
    ap.add_argument("--rate-units", default="pct", choices=["pct", "bp"])
    ap.add_argument("--hold", type=int, default=21)
    ap.add_argument("--max-hold", type=int, default=63)
    ap.add_argument("--cost-fva", type=float, default=1.5, help="round-trip cost, vol bp (placeholder)")
    ap.add_argument("--cost-spot", type=float, default=1.0, help="round-trip cost, vol bp (placeholder)")
    ap.add_argument("--source", default="auto", choices=["auto", "marks", "midcurve", "calendar"])
    ap.add_argument("--pairs", default=None, help="FVA vs FVA pairs, e.g. 6Mx1Yx10Y:2Yx1Yx10Y,3Mx6Mx10Y:1Yx6Mx10Y")
    ap.add_argument("--xs", action="store_true", help="cross-sectional FVA carry book over --points")
    ap.add_argument("--out", default="fva_lab_out")
    a = ap.parse_args(argv)
    if a.selftest:
        selftest()
        return
    if a.demo:
        df, truth = simulate()
        print("Synthetic surface (validation only - says nothing about the real market):", truth)
        split = a.split or "2020-01-01"
        if a.points == ap.get_default("points"):
            a.points = "3Mx3Mx10Y,6Mx6Mx10Y,6Mx1Yx10Y,1Yx1Yx10Y,2Yx1Yx10Y"
        a.pairs = a.pairs or "6Mx1Yx10Y:2Yx1Yx10Y,3Mx6Mx10Y:1Yx6Mx10Y"
        a.xs = True
    elif a.csv:
        df = pd.read_csv(a.csv, index_col=0, parse_dates=True)
        split = a.split
    else:
        ap.print_help()
        return
    surf = VolSurface(df, rate_units=a.rate_units)
    cfg = Config(hold_days=a.hold, max_hold=a.max_hold, cost_fva_bp=a.cost_fva, cost_spot_bp=a.cost_spot,
                 source=a.source)
    points = [FvaPoint.parse(x) for x in a.points.split(",")]
    tr, ev, res = scan(surf, points, cfg, split=split)
    _print_report(tr, ev, res, cfg)
    pair_rank, pres, xs_tab = None, {}, None
    if a.pairs:
        pairs = [tuple(FvaPoint.parse(x) for x in s.split(":")) for s in a.pairs.split(",")]
        pair_rank, pres = scan_pairs(surf, pairs, cfg, split=split)
    if a.xs:
        xs_tab = pd.concat([xs_carry(res, cfg, split, sig)[0] for sig in ("ctr", "fva_score")], ignore_index=True)
    _print_fva_only(pair_rank, pres, xs_tab)
    os.makedirs(a.out, exist_ok=True)
    tr.to_csv(os.path.join(a.out, "ranking_tranche.csv"), index=False)
    ev.to_csv(os.path.join(a.out, "ranking_event.csv"), index=False)
    if pair_rank is not None:
        pair_rank.to_csv(os.path.join(a.out, "ranking_pairs.csv"), index=False)
    if xs_tab is not None:
        xs_tab.to_csv(os.path.join(a.out, "xs_carry.csv"), index=False)
    snapshot(res, cfg).to_csv(os.path.join(a.out, "snapshot.csv"))
    pd.DataFrame({k: r.diag for k, r in res.items()}).to_csv(os.path.join(a.out, "diagnostics.csv"))
    for name, r in res.items():
        r.signals.to_csv(os.path.join(a.out, f"signals_{name}.csv"))
        plot_point(r, os.path.join(a.out, f"chart_{name}.png"))
    print(f"\nwrote rankings, snapshot, diagnostics, signals_*.csv, chart_*.png to {a.out}/")


