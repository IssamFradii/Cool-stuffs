def plot_point(r: PointResult, path: str,
               events=("ev_fva_carry", "ev_fva_carry_value", "ev_long_fva_to_fixing", "ev_stein_fade_to_fixing",
                       "ev_resid_mr", "ev_long_fwd_short_spot")) -> str:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    g = r.signals
    fig, ax = plt.subplots(4, 1, figsize=(10, 12), sharex=True)
    ax[0].plot(g.index, g["spot"], lw=1, label=f"spot {fmt_years(r.point.expiry)}x{r.point.tenor}")
    ax[0].plot(g.index, g["fwd"], lw=1, label=f"forward {r.point.name} ({r.source})")
    ax[0].set_ylabel("normal vol (bp)")
    ax[0].legend(loc="upper left", frameon=False)
    ax[1].plot(g.index, g["beta_lvl"], lw=.8, alpha=.6, label="beta levels, 1y rolling")
    ax[1].plot(g.index, g["beta_lvl_long"], lw=1.2, label="beta levels, expanding (implied persistence)")
    ax[1].plot(g.index, g["beta_real"], lw=1.2, label="realized persistence over the start")
    ax[1].plot(g.index, g["beta_chg"], lw=.8, alpha=.6, label="beta changes (hedge ratio)")
    ax[1].set_ylabel("beta")
    ax[1].legend(loc="upper left", frameon=False, fontsize=8)
    ax[2].plot(g.index, g["resid_z"], lw=.8, label="residual z (value)")
    ax[2].plot(g.index, g["ctr_z"], lw=.8, label="FVA carry-to-risk z (roll)")
    ax[2].plot(g.index, g["beta_lvl_z"], lw=.8, label="levels-beta z")
    ax[2].axhline(0, color="k", lw=.5)
    ax[2].set_ylabel("z")
    ax[2].legend(loc="upper left", frameon=False, fontsize=8)
    for s in events:
        if s in r.events:
            d = r.events[s][1]
            ax[3].plot(d.index, d.cumsum(), lw=1, label=s)
    ax[3].axhline(0, color="k", lw=.5)
    ax[3].set_ylabel("cum P&L net of costs (bp vega)")
    ax[3].legend(loc="upper left", frameon=False, fontsize=8)
    fig.suptitle(f"{r.point.name}: forward vs spot vol", y=0.995)
    fig.tight_layout()
    fig.savefig(path, dpi=110)
    plt.close(fig)
    return path


